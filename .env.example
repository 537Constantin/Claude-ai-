# ---------------------------------------------------------------------------
# KickOff — Environment variables
# ---------------------------------------------------------------------------
# The app runs out-of-the-box with built-in mock data when these are NOT set.
# Provide them to enable real Supabase auth + persistence.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Never expose to the client.
# Used by scoring cron / admin endpoints.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for OAuth redirects), e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
